// ────────────── Input Configuration ──────────────
// https://github.com/YaLTeR/niri/wiki/Configuration:-Input

gestures {
 hot-corners {
    off
 }       
}

input {
    keyboard {
        xkb {
            //If you want to overwrite your keyboard layout,
            // uncomment the line below and change the layout accordingly.
            layout "us,ru" // English + Russian
            options "grp:caps_toggle" // Caps Lock = pure layout switch, no uppercase
        }
        numlock // Enable numlock on startup
    }

    // ThinkPad, тачпад ELAN067F (04F3:3209) + рядом TrackPoint.
    //
    // Про ускорение: niri знает только два профиля — "flat" (1:1) и
    // "adaptive" (кривая). Свою кривую ("custom") niri не принимает.
    // На ELAN дефолтный adaptive даёт рывки на медленных и диагональных
    // движениях (niri#4154, репортёр на ELAN0678/ThinkPad T14), поэтому
    // ускорение управляется accel-speed в диапазоне -1.0…1.0.
    // Отрицательные значения тормозят: на быстром движении курсор
    // отстаёт от пальца. Положительные ускоряют, но на ELAN возвращаются
    // рывки. Сейчас 0.0 — компромисс, дальше крутить вверх точечно.
    touchpad {
        tap // Тап-клик

        // Отключать тачпад на время набора текста — без этого ладонь
        // во время печати ловит тапы, и ощущения портятся.
        dwt
        dwtp // то же при работе с TrackPoint

        drag true // тап-и-drag: перетаскивание без поднятия пальца
        drag-lock // не отпускать захват, если задержался на месте

        natural-scroll

        accel-profile "adaptive" // скорость подстраивается под амплитуду
        accel-speed 0.0          // дефолт. Ниже — медленно на быстром движении,
                                 // выше — быстро, но возвращаются рывки ELAN

        middle-emulation // тап тремя пальцами = средняя кнопка (вставка)
    }

    mouse {
        // If you want to disable Mouse Acceleration,
        // uncomment the lines below.
        //accel-profile "flat"
        //accel-speed 0.0
    }

    // Фокус за окном по наведению мыши.
    // max-scroll-amount="0%" запрещает срабатывание, если фокус вызвал бы
    // скролл воркспейса — чинит баг с переключением на соседнее окно,
    // когда курсор упирается в левый/правый край монитора
    // (невидимые поля ресайза клиентов с CSD вылезают за геометрию окна).
    // Полностью отключить наведение мыши: заменить блок ниже на
    // просто `// focus-follows-mouse`
    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth // Enable workspace back & forth switching
}
